            <pre id="prompt-text-3" class="text-[11px] font-mono-code text-[var(--text-muted)] p-3 rounded-lg bg-[var(--bg-card)] border border-[var(--border-main)] whitespace-pre-wrap leading-relaxed select-all">Build an offcanvas mobile navigation drawer for a high-value B2B automotive website.
Requirements:
1. Slide-over panel transitioning from right to left (width 85vw, max-w-sm) with a darkened backdrop (bg-black/60) and body scroll lock when open.
2. Grouped information architecture: Top category for "Armada & Line Up" with total unit count pill badge, secondary category for "Layanan 3S & Garansi".
3. Bottom-anchored Sales Micro-Card: A sticky card at the bottom of the drawer featuring the certified sales consultant's name, photo, and direct one-tap Call and WhatsApp buttons.
4. Smooth keyboard navigation: Pressing ESC closes the drawer, and focus traps within the modal when open.</pre>
          </div>
        </div>
      </section>

    </div>

    <!-- Navigation Back to All Components -->
    <div class="pt-8 border-t border-[var(--border-main)] flex items-center justify-between">
      <a href="/" class="text-xs font-mono-code text-[var(--text-muted)] hover:text-[var(--text-main)] flex items-center gap-1.5 transition-colors">
        <span>← Kembali ke Semua Komponen</span>
      </a>
      <a href="/panduan-belajar" class="text-xs font-mono-code text-blue-600 dark:text-blue-400 font-bold hover:underline flex items-center gap-1.5">
        <span>Lihat Peta Belajar & Decision Tree →</span>
      </a>
    </div>
  </div>

  <!-- CLIENT-SIDE SIMULATOR CONTROLLER SCRIPT -->
  <script>
    // Tab switching between Mobile and Desktop Simulator
    const btnTabMobile = document.getElementById('btn-tab-mobile-sim');
    const btnTabDesktop = document.getElementById('btn-tab-desktop-sim');
    const mobileContainer = document.getElementById('sim-mobile-container');
    const desktopContainer = document.getElementById('sim-desktop-container');

    if (btnTabMobile && btnTabDesktop && mobileContainer && desktopContainer) {
      btnTabMobile.addEventListener('click', () => {
        btnTabMobile.classList.add('bg-[var(--bg-card)]', 'text-[var(--text-main)]', 'font-semibold', 'shadow-xs', 'border', 'border-[var(--border-main)]');
        btnTabMobile.classList.remove('text-[var(--text-muted)]');
        btnTabDesktop.classList.remove('bg-[var(--bg-card)]', 'text-[var(--text-main)]', 'font-semibold', 'shadow-xs', 'border', 'border-[var(--border-main)]');
        btnTabDesktop.classList.add('text-[var(--text-muted)]');
        
        mobileContainer.classList.remove('hidden');
        desktopContainer.classList.add('hidden');
      });

      btnTabDesktop.addEventListener('click', () => {
        btnTabDesktop.classList.add('bg-[var(--bg-card)]', 'text-[var(--text-main)]', 'font-semibold', 'shadow-xs', 'border', 'border-[var(--border-main)]');
        btnTabDesktop.classList.remove('text-[var(--text-muted)]');
        btnTabMobile.classList.remove('bg-[var(--bg-card)]', 'text-[var(--text-main)]', 'font-semibold', 'shadow-xs', 'border', 'border-[var(--border-main)]');
        btnTabMobile.classList.add('text-[var(--text-muted)]');
        
        desktopContainer.classList.remove('hidden');
        mobileContainer.classList.add('hidden');
      });
    }

    // Simulated Mobile Drawer Controller
    const simHamburgerBtn = document.getElementById('sim-hamburger-btn');
    const simDrawer = document.getElementById('sim-mobile-drawer');
    const simBackdrop = document.getElementById('sim-drawer-backdrop');
    const simPanel = document.getElementById('sim-drawer-panel');
    const simClose = document.getElementById('sim-drawer-close');

    function openSimDrawer() {
      if (!simDrawer || !simBackdrop || !simPanel) return;
      simDrawer.classList.remove('pointer-events-none');
      simDrawer.classList.add('pointer-events-auto');
      simBackdrop.classList.remove('opacity-0');
      simBackdrop.classList.add('opacity-100');
      simPanel.classList.remove('translate-x-full');
      simPanel.classList.add('translate-x-0');
    }

    function closeSimDrawer() {
      if (!simDrawer || !simBackdrop || !simPanel) return;
      simBackdrop.classList.remove('opacity-100');
      simBackdrop.classList.add('opacity-0');
      simPanel.classList.remove('translate-x-0');
      simPanel.classList.add('translate-x-full');
      setTimeout(() => {
        simDrawer.classList.remove('pointer-events-auto');
        simDrawer.classList.add('pointer-events-none');
      }, 300);
    }

    if (simHamburgerBtn) simHamburgerBtn.addEventListener('click', openSimDrawer);
    if (simClose) simClose.addEventListener('click', closeSimDrawer);
    if (simBackdrop) simBackdrop.addEventListener('click', closeSimDrawer);

    // Simulated Truck Spec Sheet Bottom Sheet
    const btnOpenTruckDetail = document.getElementById('sim-btn-open-truck-detail');
    const btnCloseTruckDetail = document.getElementById('sim-btn-close-truck-detail');
    const truckSpecSheet = document.getElementById('sim-truck-spec-sheet');

    function openTruckDetail() {
      truckSpecSheet?.classList.remove('translate-y-full');
      truckSpecSheet?.classList.add('translate-y-0');
    }

    function closeTruckDetail() {
      truckSpecSheet?.classList.remove('translate-y-0');
      truckSpecSheet?.classList.add('translate-y-full');
    }

    btnOpenTruckDetail?.addEventListener('click', openTruckDetail);
    btnCloseTruckDetail?.addEventListener('click', closeTruckDetail);

    // Truck data dictionary for selection in simulated drawer
    const truckCatalog: Record<string, { name: string; category: string; icon: string; engine: string; gvw: string; karoseri: string }> = {
      dutro: {
        name: 'Hino 300 Dutro 136 HD',
        category: 'Light Duty (4 Roda / 6 Roda)',
        icon: '🚚',
        engine: 'N04C-WV Euro4 Common Rail • 136 PS @ 2.500 RPM',
        gvw: 'GVW 8.250 Kg (8.25 Ton)',
        karoseri: 'Box Besi, Bak Terbuka Kayu, Dump Truk Mini, Food Truck'
      },
      ranger: {
        name: 'Hino 500 Ranger FLX 260 JW',
        category: 'Medium Duty (6x2 - 10 Roda)',
        icon: '🚛',
        engine: 'J08E-WD Euro4 Common Rail Turbo • 260 PS @ 2.500 RPM',
        gvw: 'GVW 26.000 Kg (26 Ton)',
        karoseri: 'Wingbox Aluminium, Tangki BBM/CPO, Box Freezer, Dump Truk'
      },
      profia: {
        name: 'Hino 700 Profia Tractor Head',
        category: 'Heavy Duty (Tractor Head 6x4)',
        icon: '🚜',
        engine: 'E13C-BK Euro4 Common Rail • 410 PS @ 1.800 RPM',
        gvw: 'GCW 55.000 Kg (55 Ton)',
        karoseri: 'Trailer Kontainer 40ft, Tangki High-Capacity, Lowbed Alat Berat'
      }
    };

    const selectTruckButtons = document.querySelectorAll('.sim-select-truck');
    const simTruckIcon = document.getElementById('sim-truck-icon');
    const simTruckName = document.getElementById('sim-truck-name');
    const simTruckCategory = document.getElementById('sim-truck-category');
    const sheetTruckCategory = document.getElementById('sheet-truck-category');
    const sheetTruckName = document.getElementById('sheet-truck-name');
    const sheetTruckEngine = document.getElementById('sheet-truck-engine');
    const sheetTruckGvw = document.getElementById('sheet-truck-gvw');
    const sheetTruckKaroseri = document.getElementById('sheet-truck-karoseri');

    selectTruckButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const truckKey = btn.getAttribute('data-truck');
        if (!truckKey || !truckCatalog[truckKey]) return;
        const item = truckCatalog[truckKey];

        if (simTruckIcon) simTruckIcon.textContent = item.icon;
        if (simTruckName) simTruckName.textContent = item.name;
        if (simTruckCategory) simTruckCategory.textContent = item.category;

        if (sheetTruckCategory) sheetTruckCategory.textContent = item.category;
        if (sheetTruckName) sheetTruckName.textContent = item.name;
        if (sheetTruckEngine) sheetTruckEngine.textContent = item.engine;
        if (sheetTruckGvw) sheetTruckGvw.textContent = item.gvw;
        if (sheetTruckKaroseri) sheetTruckKaroseri.textContent = item.karoseri;

        closeSimDrawer();
      });
    });

    // Simulated CTA Lead Capture Toast Trigger
    const telemetryToast = document.getElementById('sim-telemetry-toast');
    const closeToastBtn = document.getElementById('sim-close-toast');
    const allCtaButtons = document.querySelectorAll('.sim-cta-wa, .sim-cta-call, #sim-desktop-trust-card');

    allCtaButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        if (telemetryToast) {
          telemetryToast.classList.remove('hidden');
          telemetryToast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });

    if (closeToastBtn && telemetryToast) {
      closeToastBtn.addEventListener('click', () => {
        telemetryToast.classList.add('hidden');
      });
    }

    // Copy Prompt Buttons with Feedback
    const copyPromptButtons = document.querySelectorAll('.copy-prompt-btn');
    copyPromptButtons.forEach(button => {
      button.addEventListener('click', async () => {
        const targetId = button.getAttribute('data-prompt-target');
        if (!targetId) return;
        const textElement = document.getElementById(targetId);
        if (!textElement) return;

        try {
          await navigator.clipboard.writeText(textElement.textContent || '');
          const originalText = button.innerHTML;
          button.innerHTML = '<span>✓ Tersalin!</span>';
          button.classList.add('bg-green-100', 'text-green-800', 'border-green-400');
          setTimeout(() => {
            button.innerHTML = originalText;
            button.classList.remove('bg-green-100', 'text-green-800', 'border-green-400');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy text', err);
        }
      });
    });
  </script>
</Layout>
