        <div class="space-y-6">
          <!-- Prompt 1: Hero Section + Floating Trust Card -->
          <div class="p-5 rounded-xl border border-[var(--border-main)] bg-[var(--bg-main)]">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono-code font-bold text-red-600 dark:text-red-400">
